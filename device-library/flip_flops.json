[
  {
    "type": "RS_LATCH_NAND",
    "name": "与非门型基本RS触发器",
    "category": "flip_flop",
    "family": "latch",
    "description": "由两个与非门交叉耦合构成的基本RS锁存器。S_N和R_N低有效。S_N=0置位，R_N=0复位，S_N=R_N=0非法。",
    "pins": [
      {
        "id": "S_N",
        "name": "S_N",
        "direction": "input",
        "role": "set",
        "active": "low"
      },
      {
        "id": "R_N",
        "name": "R_N",
        "direction": "input",
        "role": "reset",
        "active": "low"
      }
    ],
    "output_pins": [
      {
        "id": "Q",
        "name": "Q",
        "direction": "output",
        "role": "data",
        "active": "high"
      },
      {
        "id": "QN",
        "name": "QN",
        "direction": "output",
        "role": "data",
        "active": "high"
      }
    ],
    "params": {
      "delay": 1,
      "initial_q": 0
    }
  },
